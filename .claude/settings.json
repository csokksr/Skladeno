{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python -I C:/Study/tools/hook_guard.py" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python -I C:/Study/tools/hook_jsoncheck.py" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python -I C:/Study/tools/hook_stop_check.py", "timeout": 180 }]
      }
    ]
  }
}
