{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/hook_guard.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/hook_jsoncheck.py\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/hook_stop_check.py\"", "timeout": 180 }]
      }
    ]
  }
}
